# ============================================================
# CITSMART QUEUE MONITOR
# ============================================================

# ------------------------------------------------------------
# ACESSO AO CITSMART
# ------------------------------------------------------------

CITSMART_USERNAME=SEU_USUARIO
CITSMART_PASSWORD=SUA_SENHA

# URL completa da fila
CITSMART_QUEUE_URL=https://SEU_SERVIDOR/workflow/pages/serviceRequestIncident/serviceRequestIncident.load?iframe=true&language=pt-BR

# Host da página de autenticação.
# Exemplo: login.empresa.local
# Pode ficar vazio se não for necessário.
CITSMART_AUTH_HOST=

# ------------------------------------------------------------
# MONITORAMENTO
# ------------------------------------------------------------

# Intervalo entre leituras da fila
CHECK_INTERVAL_SECONDS=15

# Intervalo para atualização/reload da página
SOFT_REFRESH_EVERY_SECONDS=120

# Intervalo entre tentativas de reconexão
RECONNECT_EVERY_SECONDS=60

# Tempo de tolerância ao detectar que saiu da página da fila
OUT_OF_QUEUE_GRACE_SECONDS=10

# Quantidade de leituras consecutivas necessárias
# para confirmar que um chamado saiu da fila
MISSING_CONFIRMATIONS=3

# ------------------------------------------------------------
# ALERTAS
# ------------------------------------------------------------

# Tempo sem responsável antes do primeiro alerta
UNASSIGNED_ALERT_AFTER_MINUTES=8

# Intervalo para repetir alerta de chamado sem responsável
UNASSIGNED_REPEAT_MINUTES=5

# Considera o SLA "a vencer" quando estiver dentro desta janela
DUE_SOON_MINUTES=30

# Intervalo para repetir alertas de SLA
DUE_ALERT_REPEAT_MINUTES=10

# Dias para considerar uma suspensão prolongada
SUSPENDED_ALERT_DAYS=14

# Intervalo mínimo entre alertas repetidos de erro
ERROR_ALERT_COOLDOWN_MINUTES=10

# ------------------------------------------------------------
# NAVEGADOR
# ------------------------------------------------------------

# true = navegador principal oculto
# false = navegador visível
HEADLESS=true

# Traz a aplicação para frente ao gerar alerta
BRING_TO_FRONT_ON_ALERT=true

# Use chrome se o Google Chrome estiver instalado
CHROME_CHANNEL=chrome

# ------------------------------------------------------------
# LOG
# ------------------------------------------------------------

LOG_FILE_LEVEL=INFO

# Os caminhos abaixo são opcionais.
# Se vazios/ausentes, o programa utiliza os padrões internos.
#
# LOG_FILE=
# DATABASE_FILE=
# STATE_FILE=
# BROWSER_SESSION_DIR=
# INS_BROWSER_SESSION_DIR=
# D1_BROWSER_SESSION_DIR=

# ============================================================
# SMART REPORTS / INS
# OPCIONAL — preencha somente se utilizar esse módulo
# ============================================================

CITSMART_SMART_REPORTS_URL=

INS_PESQUISA_REPORT_ID=
INS_TIT_REPORT_ID=
INS_TMS_REPORT_ID=

INS_CONTRACT_ID=

# Para mais de um grupo, separar por vírgula.
# Exemplo: 100,200
INS_GROUP_IDS=

# ============================================================
# CHAMADO D-1
# OPCIONAL — preencha somente se utilizar esse módulo
# ============================================================

CITSMART_D1_REQUEST_URL=

D1_REQUESTER_NAME=
D1_REQUESTER_EMAIL=
D1_CONTACT_ORIGIN=
D1_ACTIVITY=
D1_CONTACT_METHOD=
D1_SERVICE_TEAM=
D1_STATE=
D1_LOCATION=
D1_IS_MANAGER=
